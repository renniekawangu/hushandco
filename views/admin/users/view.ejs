<%- include('../../partials/header') %>

<section class="admin-section users-admin-page user-detail-page">
        <div class="section-card">
            <div class="section-header">
                <div class="header-main">
                    <h2>User Details</h2>
                    <a href="/admin/users" class="btn btn-outline">Back to Users</a>
                </div>
            </div>

            <div class="section-content">
                <div class="user-details">
                    <div class="detail-group">
                        <label>Name</label>
                        <p><%= user.name %></p>
                    </div>

                    <div class="detail-group">
                        <label>Email</label>
                        <p><%= user.email %></p>
                    </div>

                    <div class="detail-group">
                        <label>Role</label>
                        <p>
                            <span class="badge <%= user.isAdmin ? 'badge-admin' : 'badge-user' %>">
                                <%= user.isAdmin ? 'Admin' : 'User' %>
                            </span>
                        </p>
                    </div>

                    <div class="detail-group">
                        <label>Phone</label>
                        <p><%= user.phone || 'Not provided' %></p>
                    </div>

                    <div class="detail-group">
                        <label>Member Since</label>
                        <p><%= new Date(user.createdAt).toLocaleDateString() %></p>
                    </div>

                    <% if (user.email !== locals.user.email) { %>
                        <div class="user-actions">
                            <form action="/admin/users/<%= user._id %>/role" method="POST" class="inline-form">
                                <input type="hidden" name="action" value="<%= user.isAdmin ? 'remove-admin' : 'make-admin' %>">
                                <button type="submit" class="btn <%= user.isAdmin ? 'btn-warning' : 'btn-secondary' %>">
                                    <%= user.isAdmin ? 'Remove Admin Rights' : 'Make Admin' %>
                                </button>
                            </form>

                            <form 
                                action="/admin/users/<%= user._id %>/delete" 
                                method="POST" 
                                class="inline-form"
                                onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.')"
                            >
                                <button type="submit" class="btn btn-danger">Delete User</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
</section>

<%- include('../../partials/footer') %>
