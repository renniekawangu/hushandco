<%- include('../../partials/header', { title: 'Edit Category' }) %>

<section class="admin-section">
    <div class="section-header">
        <div class="section-header-main">
            <h2>Edit Category</h2>
        </div>
    </div>

    <div class="section-content">
        <form method="POST" action="/admin/categories/<%= category._id %>" class="form-container">
            <div class="form-group">
                <label for="name">Category Name <span class="required">*</span></label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    class="form-control" 
                    value="<%= category.name || '' %>"
                    required
                    autofocus
                >
                <small class="form-help">The name of the category that customers will see</small>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea 
                    id="description" 
                    name="description" 
                    class="form-control" 
                    rows="4"
                ><%= category.description || '' %></textarea>
                <small class="form-help">A brief description to help organize your categories</small>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Update Category</button>
                <a href="/admin/categories" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</section>
