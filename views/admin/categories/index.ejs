<%- include('../../partials/header', { title: 'Categories' }) %>

<section class="admin-section">
    <div class="section-header">
        <div class="section-header-main">
            <h2>Categories</h2>
            <% if (categories && categories.length > 0) { %>
                <span class="badge badge-count"><%= categories.length %> categories</span>
            <% } %>
        </div>

        <div class="filters">
            <a href="/admin/categories/add" class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Add Category
            </a>
        </div>
    </div>

    <div class="section-content">
        <% if (categories && categories.length > 0) { %>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% categories.forEach(category => { %>
                        <tr>
                            <td class="table-cell-primary">
                                <strong><%= category.name %></strong>
                            </td>
                            <td>
                                <%= category.description ? category.description.substring(0, 60) + (category.description.length > 60 ? '...' : '') : '-' %>
                            </td>
                            <td>
                                <small><%= category.createdAt ? new Date(category.createdAt).toLocaleDateString() : '-' %></small>
                            </td>
                            <td class="table-actions">
                                <a href="/admin/categories/<%= category._id %>/edit" class="action-link edit-link" title="Edit">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                                        <path d="M12 20h9"></path>
                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19H4v-3L16.5 3.5z"></path>
                                    </svg>
                                </a>
                                <form method="POST" action="/admin/categories/<%= category._id %>/delete" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                    <button type="submit" class="action-link delete-link" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            <line x1="10" y1="11" x2="10" y2="17"></line>
                                            <line x1="14" y1="11" x2="14" y2="17"></line>
                                        </svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <div class="empty-state">
                <h3>No categories yet</h3>
                <p>Get started by creating your first category.</p>
                <a href="/admin/categories/add" class="btn btn-primary">Add Category</a>
            </div>
        <% } %>
    </div>
</section>
