<%- include('./partials/header', {title: 'Payment Method', showBackButton: true}) %>

<div class="content-wrapper">
    <div class="grid-layout-full">
        <div class="section-card">
            <div class="section-header">
                <h2>Select Payment Method</h2>
            </div>
            <div class="section-content">
                <div class="payment-methods">
                    <form id="paymentMethodForm" action="/products/process-payment" method="POST">
                        
                        <div class="payment-method-option">
                            <input type="radio" id="airtelMoney" name="paymentMethod" value="AirtelMoney" checked>
                            <label for="airtelMoney" class="payment-method-label">
                                <div class="method-header">
                                    <span class="method-icon">📱</span>
                                    <h3>Airtel Money</h3>
                                </div>
                                <p class="method-description">Pay directly using your Airtel Money account. Fast, secure, and convenient.</p>
                                <div class="method-features">
                                    <ul>
                                        <li>✓ Instant payment confirmation</li>
                                        <li>✓ Available on all Airtel networks</li>
                                        <li>✓ No hidden charges</li>
                                    </ul>
                                </div>
                            </label>
                        </div>

                        <div class="payment-method-option">
                            <input type="radio" id="creditCard" name="paymentMethod" value="CreditCard" disabled>
                            <label for="creditCard" class="payment-method-label disabled">
                                <div class="method-header">
                                    <span class="method-icon">💳</span>
                                    <h3>Credit/Debit Card</h3>
                                </div>
                                <p class="method-description">Coming soon - Pay using your credit or debit card</p>
                                <span class="badge-coming-soon">Coming Soon</span>
                            </label>
                        </div>

                        <div class="payment-method-option">
                            <input type="radio" id="bankTransfer" name="paymentMethod" value="BankTransfer" disabled>
                            <label for="bankTransfer" class="payment-method-label disabled">
                                <div class="method-header">
                                    <span class="method-icon">🏦</span>
                                    <h3>Bank Transfer</h3>
                                </div>
                                <p class="method-description">Coming soon - Transfer funds directly from your bank account</p>
                                <span class="badge-coming-soon">Coming Soon</span>
                            </label>
                        </div>

                        <div class="order-summary mt-4">
                            <h3>Order Summary</h3>
                            <div class="summary-items">
                                <% cart.forEach(item => { %>
                                    <div class="summary-item">
                                        <span><%= item.name %></span>
                                        <span>x<%= item.quantity %></span>
                                        <span class="item-price">K<%= (item.price * item.quantity).toFixed(2) %></span>
                                    </div>
                                <% }); %>
                            </div>
                            <div class="summary-total">
                                <h4>Total Amount: <span class="total-amount">K<%= cart.reduce((total, item) => total + (item.price * item.quantity), 0).toFixed(2) %></span></h4>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg btn-block mt-4">Continue to Payment</button>
                        <a href="/products/checkout" class="btn btn-secondary btn-block mt-2">Back to Checkout</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .payment-methods {
        padding: 20px 0;
    }

    .payment-method-option {
        margin-bottom: 20px;
    }

    .payment-method-option input[type="radio"] {
        display: none;
    }

    .payment-method-label {
        display: block;
        padding: 20px;
        border: 2px solid var(--border-color);
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        background-color: var(--surface-elevated);
        color: var(--text-color);
    }

    .payment-method-option input[type="radio"]:checked + .payment-method-label {
        border-color: var(--primary-color);
        background-color: var(--background-secondary);
        box-shadow: 0 0 15px rgba(198, 161, 91, 0.12);
    }

    .payment-method-label.disabled {
        opacity: 0.6;
        cursor: not-allowed;
        background-color: var(--background-secondary);
        color: var(--text-muted);
    }

    .method-header {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
    }

    .method-icon {
        font-size: 40px;
        margin-right: 15px;
    }

    .method-header h3 {
        margin: 0;
        font-size: 20px;
        color: var(--text-color);
    }

    .method-description {
        margin: 10px 0;
        color: var(--text-muted);
        font-size: 15px;
    }

    .method-features ul {
        list-style: none;
        padding: 0;
        margin: 10px 0 0 0;
    }

    .method-features li {
        padding: 5px 0;
        color: var(--text-secondary);
        font-size: 14px;
    }

    .badge-coming-soon {
        display: inline-block;
        background-color: var(--background-secondary);
        color: var(--text-muted);
        padding: 5px 10px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        margin-top: 10px;
    }

    .order-summary {
        background-color: var(--surface-elevated);
        padding: 20px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

    .order-summary h3 {
        margin-top: 0;
        margin-bottom: 15px;
        color: var(--text-color);
    }

    .summary-items {
        margin-bottom: 15px;
    }

    .summary-item {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid var(--border-color);
        font-size: 15px;
    }

    .summary-item:last-child {
        border-bottom: none;
    }

    .item-price {
        font-weight: bold;
        color: var(--primary-color);
    }

    .summary-total {
        padding-top: 15px;
        border-top: 2px solid var(--border-color);
        text-align: right;
    }

    .summary-total h4 {
        margin: 0;
        font-size: 18px;
        color: var(--text-color);
    }

    .total-amount {
        color: var(--accent-color);
        font-size: 20px;
    }

    .btn {
        padding: 12px 20px;
        border: none;
        border-radius: 4px;
        font-size: 16px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: var(--primary-color);
        color: var(--text-inverse);
        width: 100%;
    }

    .btn-primary:hover {
        background-color: var(--secondary-color);
    }

    .btn-secondary {
        background-color: var(--border-color);
        color: var(--text-light);
        width: 100%;
        text-align: center;
    }

    .btn-secondary:hover {
        background-color: var(--surface-elevated);
    }

    .btn-lg {
        padding: 15px 30px;
        font-size: 18px;
    }

    .btn-block {
        display: block;
        width: 100%;
    }

    .mt-2 {
        margin-top: 15px;
    }

    .mt-4 {
        margin-top: 30px;
    }

    @media (max-width: 768px) {
        .payment-method-label {
            padding: 15px;
        }

        .method-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .method-icon {
            margin-right: 0;
            margin-bottom: 10px;
        }

        .summary-item {
            flex-wrap: wrap;
        }

        .item-price {
            width: 100%;
            text-align: right;
        }
    }
</style>

<%- include('./partials/footer') %>
</body>
</html>
