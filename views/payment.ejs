<%- include('./partials/header', {title: 'Airtel Money Payment', showBackButton: true}) %>

<div class="content-wrapper">
    <div class="grid-layout-full">
        <div class="section-card">
            <div class="section-header">
                <h2>Airtel Money Payment</h2>
            </div>
            <div class="section-content">
                <div class="payment-container">
                    <div class="payment-info">
                        <h3>Order Summary</h3>
                        <div class="order-details">
                            <p><strong>Order ID:</strong> <%= order._id %></p>
                            <p><strong>Amount:</strong> UGX <%= order.totalAmount.toFixed(2) %></p>
                            <p><strong>Status:</strong> <span class="badge badge-<%= order.paymentStatus.toLowerCase() %>"><%= order.paymentStatus %></span></p>
                        </div>
                    </div>

                    <% if (order.paymentStatus === 'Pending') { %>
                        <form id="paymentForm" class="payment-form">
                            <div class="form-group">
                                <label for="phoneNumber">Airtel Money Phone Number:</label>
                                <input 
                                    type="tel" 
                                    id="phoneNumber" 
                                    name="phoneNumber" 
                                    class="form-control" 
                                    placeholder="+256 700 000000 or 0700000000"
                                    required
                                    pattern="^[\d\+\-\s]+$"
                                >
                                <small class="form-text text-muted">Enter your Airtel Money registered phone number</small>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg btn-block" id="paymentBtn">
                                Proceed to Payment
                            </button>

                            <a href="/products/checkout" class="btn btn-secondary btn-block mt-2">Cancel</a>
                        </form>

                        <div id="paymentStatus" style="display: none;" class="alert mt-3"></div>
                    <% } else if (order.paymentStatus === 'Completed') { %>
                        <div class="alert alert-success">
                            <h4>Payment Successful!</h4>
                            <p>Thank you for your purchase. Your order is now being processed.</p>
                            <p><strong>Transaction ID:</strong> <%= order.paymentDetails?.transactionId || 'N/A' %></p>
                            <a href="/profile" class="btn btn-primary mt-3">View Your Orders</a>
                        </div>
                    <% } else if (order.paymentStatus === 'Failed') { %>
                        <div class="alert alert-danger">
                            <h4>Payment Failed</h4>
                            <p>Your payment could not be processed. Please try again.</p>
                            <button type="button" class="btn btn-warning mt-3" onclick="retryPayment('<%= order._id %>')">Retry Payment</button>
                            <a href="/products/checkout" class="btn btn-secondary mt-3">Return to Checkout</a>
                        </div>

                        <div id="retryForm" style="display: none;" class="mt-4">
                            <h4>Retry Payment</h4>
                            <form id="retryPaymentForm" class="payment-form">
                                <div class="form-group">
                                    <label for="retryPhoneNumber">Airtel Money Phone Number:</label>
                                    <input 
                                        type="tel" 
                                        id="retryPhoneNumber" 
                                        name="phoneNumber" 
                                        class="form-control" 
                                        placeholder="+256 700 000000 or 0700000000"
                                        required
                                        pattern="^[\d\+\-\s]+$"
                                    >
                                </div>
                                <button type="submit" class="btn btn-primary btn-lg btn-block">Retry Payment</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="section-card">
            <div class="section-header">
                <h2>Payment Instructions</h2>
            </div>
            <div class="section-content">
                <div class="instructions">
                    <h4>How to Pay with Airtel Money:</h4>
                    <ol>
                        <li>Enter your Airtel Money registered phone number</li>
                        <li>Click "Proceed to Payment"</li>
                        <li>You will receive an Airtel Money prompt on your phone</li>
                        <li>Enter your Airtel Money PIN to confirm payment</li>
                        <li>Your order will be confirmed upon successful payment</li>
                    </ol>

                    <h4 class="mt-4">Why Airtel Money?</h4>
                    <ul>
                        <li>✓ Fast and secure payment processing</li>
                        <li>✓ Available on all Airtel networks</li>
                        <li>✓ No hidden charges</li>
                        <li>✓ Instant payment confirmation</li>
                    </ul>

                    <div class="alert alert-info mt-4">
                        <strong>Note:</strong> Make sure your Airtel Money account has sufficient funds before initiating payment.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .payment-container {
        padding: 20px;
    }

    .payment-info {
        background-color: var(--surface-elevated);
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
        color: var(--text-color);
    }

    .order-details p {
        margin: 10px 0;
        font-size: 16px;
    }

    .badge {
        padding: 5px 10px;
        border-radius: 4px;
        font-size: 14px;
        font-weight: bold;
    }

    .badge-pending {
        background-color: rgba(198, 161, 91, 0.12);
        color: var(--accent-color);
    }

    .badge-completed {
        background-color: rgba(76, 175, 80, 0.12);
        color: #4caf50;
    }

    .badge-failed {
        background-color: rgba(244, 67, 54, 0.12);
        color: #ef5350;
    }

    .payment-form {
        background-color: var(--surface-elevated);
        padding: 20px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        margin: 20px 0;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: var(--text-color);
    }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        font-size: 16px;
        background-color: var(--background-secondary);
        color: var(--text-color);
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 8px rgba(198, 161, 91, 0.18);
    }

    .form-text {
        display: block;
        margin-top: 5px;
        font-size: 14px;
        color: var(--text-muted);
    }

    .btn {
        padding: 12px 20px;
        border: none;
        border-radius: 4px;
        font-size: 16px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: var(--primary-color);
        color: var(--text-inverse);
    }

    .btn-primary:hover {
        background-color: var(--secondary-color);
    }

    .btn-secondary {
        background-color: var(--border-color);
        color: var(--text-light);
    }

    .btn-secondary:hover {
        background-color: var(--surface-elevated);
    }

    .btn-warning {
        background-color: var(--accent-color);
        color: var(--text-inverse);
    }

    .btn-warning:hover {
        background-color: var(--primary-color);
    }

    .btn-lg {
        padding: 15px 30px;
        font-size: 18px;
    }

    .btn-block {
        width: 100%;
        text-align: center;
    }

    .mt-2 {
        margin-top: 15px;
    }

    .mt-3 {
        margin-top: 20px;
    }

    .mt-4 {
        margin-top: 30px;
    }

    .alert {
        padding: 15px;
        margin: 20px 0;
        border-radius: 4px;
    }

    .alert-success {
        background-color: rgba(76, 175, 80, 0.12);
        color: #4caf50;
        border: 1px solid rgba(76, 175, 80, 0.25);
    }

    .alert-danger {
        background-color: rgba(244, 67, 54, 0.12);
        color: #ef5350;
        border: 1px solid rgba(244, 67, 54, 0.25);
    }

    .alert-info {
        background-color: rgba(0, 123, 255, 0.12);
        color: var(--primary-color);
        border: 1px solid rgba(198, 161, 91, 0.2);
    }

    .alert h4 {
        margin-top: 0;
        margin-bottom: 10px;
    }

    .instructions ol, .instructions ul {
        margin-left: 20px;
    }

    .instructions li {
        margin: 10px 0;
        line-height: 1.6;
    }

    .instructions h4 {
        margin-top: 20px;
        margin-bottom: 15px;
        color: var(--text-color);
    }

    #paymentStatus {
        padding: 15px;
        border-radius: 4px;
        margin-top: 20px;
        background: var(--background-secondary);
        color: var(--text-color);
        border: 1px solid var(--border-color);
    }

    .spinner {
        border: 4px solid var(--background-secondary);
        border-top: 4px solid var(--primary-color);
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin: 20px auto;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<script>
document.getElementById('paymentForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const phoneNumber = document.getElementById('phoneNumber').value;
    const orderId = '<%= order._id %>';
    const paymentBtn = document.getElementById('paymentBtn');
    const paymentStatus = document.getElementById('paymentStatus');

    try {
        paymentBtn.disabled = true;
        paymentBtn.textContent = 'Processing...';
        paymentStatus.style.display = 'block';
        paymentStatus.className = 'alert alert-info';
        paymentStatus.innerHTML = '<div class="spinner"></div><p>Initiating payment...</p>';

        const response = await fetch('/payments/initiate', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                orderId,
                phoneNumber
            })
        });

        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.error || 'Payment initiation failed');
        }

        paymentStatus.className = 'alert alert-success';
        paymentStatus.innerHTML = `
            <h4>Payment Initiated Successfully</h4>
            <p>Check your Airtel Money prompt on phone number ${phoneNumber}</p>
            <p>Please enter your PIN to confirm payment.</p>
        `;

        // Poll for payment status
        setTimeout(() => checkPaymentStatus(orderId), 3000);

    } catch (error) {
        paymentBtn.disabled = false;
        paymentBtn.textContent = 'Proceed to Payment';
        paymentStatus.className = 'alert alert-danger';
        paymentStatus.innerHTML = `<h4>Error</h4><p>${error.message}</p>`;
        console.error('Payment error:', error);
    }
});

document.getElementById('retryPaymentForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const phoneNumber = document.getElementById('retryPhoneNumber').value;
    const orderId = '<%= order._id %>';

    try {
        const response = await fetch(`/payments/retry/${orderId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ phoneNumber })
        });

        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.error || 'Payment retry failed');
        }

        alert('Payment request sent. Check your phone for the Airtel Money prompt.');
        setTimeout(() => checkPaymentStatus(orderId), 3000);

    } catch (error) {
        alert('Error: ' + error.message);
    }
});

function retryPayment(orderId) {
    document.getElementById('retryForm').style.display = 'block';
}

async function checkPaymentStatus(orderId) {
    try {
        const response = await fetch(`/payments/order/${orderId}`);
        const data = await response.json();

        if (data.success && data.order) {
            if (data.order.paymentStatus === 'Completed') {
                window.location.href = '/confirmation?orderId=' + orderId;
            } else if (data.order.paymentStatus === 'Failed') {
                document.getElementById('paymentStatus').className = 'alert alert-danger';
                document.getElementById('paymentStatus').innerHTML = '<h4>Payment Failed</h4><p>Please try again or contact support.</p>';
            }
        }
    } catch (error) {
        console.error('Status check error:', error);
    }
}
</script>

<%- include('./partials/footer') %>
</body>
</html>
